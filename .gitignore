# Virtual environment
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Engagement data — NEVER commit (contains real targets, creds, scan output)
artifacts/
*.db
audit.log
scope.txt
gowitness.jsonl

# Centralized data dir (KALI_MCP_DATA_DIR) — all runtime state lives here.
# The per-file patterns above already match inside it, but ignore common
# data-dir names outright as a safety net.
data/
kali-mcp-data/

# Credential vault and engagement databases (plaintext secrets)
vault.db
jobs.db
engagements.db

# Credential vault encryption key — NEVER commit
vault.key

# SSH TOFU host-key pins — local trust store, never commit
known_hosts

# Local MCP/client config that may hold tokens
claude_desktop_config.json

# Local Kiro workspace config (absolute local paths — not for the public repo)
.kiro/

# OS noise
.DS_Store
*.swp

# Local backup of pre-clean git history — never commit
.git.backup-*/
